    "@repoladder/brand": "^0.1.1",
    "@terrastruct/d2": "^0.1.33",
    "@types/node": "^26.6.5",
    "elkjs": "^0.12.0",
    "esbuild": "^0.28.2",
    "fontverter": "2.0.0",
    "gifenc": "1.0.3",
    "playwright": "1.64.1",
    "subset-font": "2.9.0",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  }
