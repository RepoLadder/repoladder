{
  "name": "repoladder",
  "version": "0.2.0",
  "private": true,
  "description": "Architecture diagrams grounded in your code that stay in sync.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "analyze": "node src/cli.ts analyze",
    "gallery": "node scripts/gallery.ts",
    "design": "node scripts/design.ts",
    "titlecheck": "node scripts/titlecheck.ts",
    "bench:layout": "node scripts/layoutbench.ts",
    "shots": "node scripts/shots.ts",
    "shots:phone": "node scripts/phoneshots.ts",
    "exportcheck": "node scripts/exportcheck.ts",
    "lint:layout": "node scripts/lint.ts",
    "stability": "node scripts/stability.ts",
    "installcheck": "node scripts/installcheck.ts",
    "verify:settings": "node scripts/verifysettings.ts",
    "clearcheck": "node scripts/clearcheck.ts",
    "guardbase": "node scripts/guardbase.ts",
    "motioncheck": "node scripts/motioncheck.ts",
    "tourcheck": "node scripts/tourcheck.ts",
    "npm:pack": "node scripts/npm-package.ts",
    "readme-media": "node scripts/readme-media.ts",
    "legal": "node scripts/legal.ts",
    "leakguard": "node scripts/leakguard.ts",
